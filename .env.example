# DynamoDB-backed user store (primary key = mobile, secondary lookup = email via GSI).
AWS_REGION=ap-south-1
DYNAMODB_TABLE_USERS=devopsmate_users
# Leave empty in real AWS/EKS (uses IAM role / IRSA via default credential chain).
# Point at DynamoDB Local for local dev, e.g. http://localhost:8500 or http://dynamodb-local:8000 in Docker Compose.
DYNAMODB_ENDPOINT_URL=
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# Laptop: mail is caught by MailHog (http://localhost:8025).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM="DevOpsMate <devopsmate7@gmail.com>"
SMTP_TLS=false

# EC2: real Gmail. scripts/setup-gmail.sh writes these into .env (never commit .env).
